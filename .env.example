# DESIGN CONTRACT ONLY — no real secrets; Stage 3 adds validation.
# Infrastructure/secrets belong here; COD, shipping rates, tax policies and business toggles belong in DB settings.
# Required at application runtime, server-only:
APP_ENV=development
APP_URL=http://localhost:3000
MONGODB_URI=
MONGODB_DB_NAME=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Proposed bounded pool, tune across all processes/instances:
MONGODB_MAX_POOL_SIZE=10

# Required only when media is enabled; server-only:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required only when Razorpay is enabled; server-only:
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test
# Public provider key ID may be returned deliberately by checkout; never expose key secret.

# Required when durable jobs are enabled; server-only:
JOBS_TRIGGER_SECRET=
# Cadence is scheduler deployment config, not an in-process timer.
JOBS_BATCH_LIMIT=25
JOBS_TIME_BUDGET_MS=20000

# Email provider choice before auth/recovery implementation; server-only:
EMAIL_PROVIDER=
EMAIL_FROM=
RESEND_API_KEY=
# Alternative SMTP fields; do not configure both transports:
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Optional private invoice/import artifact backend; server-only, implementation deferred:
PRIVATE_STORAGE_PROVIDER=
PRIVATE_STORAGE_BUCKET=
PRIVATE_STORAGE_ENDPOINT=
PRIVATE_STORAGE_ACCESS_KEY_ID=
PRIVATE_STORAGE_SECRET_ACCESS_KEY=

# Optional monitoring/automation; server-only:
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Optional intentionally public identifiers only:
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# No NEXT_PUBLIC_ credentials or secrets.
