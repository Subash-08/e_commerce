{
  "name": "reusable-ecommerce-base",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write src scripts tests \"*.{json,mjs,cjs,ts}\"",
    "format:check": "prettier --check src scripts tests \"*.{json,mjs,cjs,ts}\"",
    "check:docs": "node scripts/check-docs.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:enums": "node scripts/check-enums.mjs",
    "check:diagrams": "node scripts/check-diagrams.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "verify": "npm run test && npm run lint && npm run typecheck && npm run build && npm run check:docs && npm run check:secrets && npm run check:enums && npm run check:diagrams && npm run check:routes",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:states": "node scripts/generate-states.mjs --write"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "12.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "postcss": "8.5.29",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
